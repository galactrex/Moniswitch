[Unit]
Description=Moniswitch keyboard and mouse receiver
After=graphical-session.target network-online.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=WAYNERGY_CONF_PATH=%h/.config/waynergy
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env waynergy --backend wlr --fatal-none --fatal-ebad --fatal-ebsy --fatal-timeout
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
